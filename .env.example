# ---------------------------------------------------
# DATABASE
# Local dev uses SQLite. For production, swap the
# provider in prisma/schema.prisma to "postgresql" and
# point DATABASE_URL at your Postgres instance.
# ---------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------
# AUTH.JS (NextAuth v5)
# Generate AUTH_SECRET with: npx auth secret
# ---------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------
# MONETIZATION
# Comma-free JSON map of country -> affiliate tag
# ---------------------------------------------------
AFFILIATE_TAG_DEFAULT="peripheralshub-20"
AFFILIATE_TAG_US="peripheralshub-us-20"
AFFILIATE_TAG_UK="peripheralshub-uk-21"
AFFILIATE_TAG_IN="peripheralshub-in-21"

# ---------------------------------------------------
# INGESTION ENGINE
# "mock" uses the built-in simulated fetch layer (safe, instant).
# "playwright" runs real headless browser scraping against SCRAPE_TARGETS.
# ---------------------------------------------------
SYNC_MODE="mock"

# ---------------------------------------------------
# ADMIN + SCHEDULING
# Emails (comma-separated) auto-promoted to ADMIN on sign-in.
# ---------------------------------------------------
ADMIN_EMAILS="you@example.com"
# Secures GET /api/cron/sync (Vercel Cron sends it automatically)
CRON_SECRET="replace-with-random-string"
# Per-product delay in ms so the admin console streams visibly
SYNC_STEP_DELAY_MS=150
# Playwright targets (JSON). Leave empty to use the mock feed.
# SCRAPE_TARGETS='[{"sku":"MOU-X","url":"https://example.com/p/x","category":"MOUSE","connectionType":"WIRELESS","platform":"example"}]'
